# ─── Global Environment Configuration Template (v1.0.0-rc1) ─────────────────
PROJECT_NAME="Antigravity AI Academic Research Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="production"       # "development" | "testing" | "production"
DEBUG=false
SECRET_KEY="replace-with-a-secure-random-64-char-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in production, SQLite in development)
DATABASE_URL="sqlite:///./ai_research_dev.db"
# Example PostgreSQL / Supabase:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_research_db"

# Real AI Provider Credentials (Server-Side Only - Never Exposed to Frontend)
GEMINI_API_KEY=""              # https://aistudio.google.com/app/apikey
DEFAULT_AI_MODEL="gemini-1.5-pro"

# Optional Additional AI Providers
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Academic Source API Keys (Public pools used by default; keys elevate quotas)
SEMANTIC_SCHOLAR_API_KEY=""
# ELSEVIER_API_KEY=""
# SPRINGER_API_KEY=""

# Security, CORS & Rate Limiting
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
RATE_LIMIT_PER_MINUTE=1000

# Continuous Monitoring Scheduler Settings
SCHEDULER_CHECK_INTERVAL_SECONDS=300
MONITORING_MAX_RETRIES=2
MONITORING_MIN_INTERVAL_SECONDS=3600

# Desktop Companion & Local Sandbox
DESKTOP_SANDBOX_PATH="./sandbox"
DESKTOP_PIN_EXPIRY_SECONDS=300
DESKTOP_MAX_FILE_BYTES=10485760   # 10 MB per file limit
