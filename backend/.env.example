# Server Configuration
PROJECT_NAME="AI Research & Personal Assistant Platform"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=115200

# Database Configuration (PostgreSQL / Supabase or SQLite fallback)
DATABASE_URL="sqlite:///./ai_research_dev.db"
# Production PostgreSQL / Supabase example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_research_db"

# AI Provider Keys (Server-Side Only - Never Exposed to Frontend)
GEMINI_API_KEY=""
DEFAULT_AI_MODEL="gemini-1.5-pro"

# Optional Additional AI Providers (Modular Architecture)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Optional Academic API Keys (Public pools used by default without keys)
SEMANTIC_SCHOLAR_API_KEY=""

# CORS Allowed Origins (Comma separated)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
